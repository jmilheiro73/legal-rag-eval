# Copy to .env and load it into the shell before running:  set -a; . ./.env; set +a
# Any OpenAI-compatible endpoint works; see the provider table in README.md.

# Chat model (end-to-end evaluation)
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=
LLM_API_KEY=

# Embeddings (ingestion and retrieval)
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_MODEL=bge-m3
EMBED_API_KEY=

# Qdrant: a server (docker compose up -d) or, with QDRANT_PATH, embedded mode with no server
QDRANT_URL=http://localhost:6333
QDRANT_PATH=
COLLECTION=legal_rag_eval

TOP_K=5
TEMPERATURE=0

# Optional: Langfuse datasets and experiments. Leave empty to run without it.
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
